# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# Stripe — dashboard.stripe.com > Developers > API keys / Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public site URL, used to build success/cancel redirect links for Stripe Checkout.
# Locally: http://localhost:3000. In production: your Netlify URL or custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
